{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "core": {
      "type": "object",
      "properties": {
        "manifestVersion": {
          "const": "1.1.0"
        },
        "schemaVersion": {
          "const": "0.3.0"
        },
        "templateVersion": {
          "enum": [
            "migration-0.3.0-b3",
            "view-0.3.0-b3",
            "evaluator-0.3.0-b3"
          ]
        },
        "target": {
          "enum": [
            "sqlite",
            "postgresql"
          ]
        },
        "specificationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verificationDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5242880
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "verificationRuntime": {
          "type": "string"
        },
        "module": {
          "enum": [
            "migration",
            "view",
            "evaluator"
          ]
        },
        "executableSql": {
          "type": "boolean"
        },
        "rulesetVersion": {
          "const": "schema-rules-0.3.0"
        }
      },
      "required": [
        "manifestVersion",
        "schemaVersion",
        "templateVersion",
        "target",
        "specificationDigest",
        "verificationDependencies",
        "limitations",
        "files",
        "verificationRuntime",
        "module",
        "executableSql"
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "core",
    "digest"
  ],
  "additionalProperties": false
}
